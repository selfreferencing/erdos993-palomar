module

public import Erdos993Lean.Analytic.Defs

/-!
# O2: the shared interface of the correlated-innovation payment

(Consumed by the certificate
checker).  This file fixes, in real-number terms and with no tree in it, the local payment of the
O2 proof and the band propositions that the certificates discharge; it contains definitions only.

Sources: the O2 proof, §1–§9 (the payment `Φ`, eq. (11); the
physical domain, Lemma 1; the source `g`, Lemma 2; the packed child masses `H, φ`, eqs. (7)–(8);
the small-message boundary §7; the leaf endpoint §8; the tables §9), its implementation map
§2–§3 (obligations 4–5, the retained-`Y` parent bound), and the coefficient tables of the 14
certified rows: the six R2 rows and the eight gap rows
embedded in the tight certificates;
every row certifies R2's broad domain.

## The objects

* `CoeffTable`, `BandData`: a band `[lo, hi]` with price `γ`, the start `xmin` of its certified
  `x`-cover, and two rational tables (at `λ = lo` and `λ = hi`) of the knot values of `u, v, s, τ`
  at `x = p/q = j/8` (`j = 0, …, 8`) and of the multipliers `w, ℓ`.
* Their real interpretation at the common actual activity `λ` (`BandData.uF`, `vF`, `sF`, `tauF`,
  `wF`, `ellF`): every knot value is linear in `λ` on `[lo, hi]` (`lerp`); at a cavity probability
  `p` the field is the piecewise-linear interpolation in `x = p/q_λ` on the nine knots (`pwLin`).
  The price is `c = γ/(1 + λ)` (`BandData.price`).
* The source (Lemma 2): `f_q` (`fq`), `H_c` (`cavH`), `M_up` (`mUp`), `g` (`src`).
* The child-mass quantities (§4): `T = log(λ(1−p)/p)` (`logMass`), `j = ⌊T/L⌋`, `L = log(1+λ)`
  (`packJ`), `H = jλ + e^{T−jL} − 1` (`packH`), `φ = jq + 1 − e^{−(T−jL)}` (`packPhi`),
  `h = p/(−log(1−p))` (`hFun`), `G = log(p/(λ(1−p)²))` (`logG`).
* The local payment at a physical nonroot record `(p, r, t, z)` — own cavity probability `p`,
  `r = 1 − π_parent`, the parent's cavity probability `t`, the signed total-count response `z` —
  `Φ = c r g − r(1−p)z² + R_u + R_v + R_s + R_τ + w R_w − ℓ G/p` (`BandData.Phi`, eq. (11)), and the
  root payment `BandData.PhiRoot` (no incoming parent charges, `r = 1`).
* The physical record domain `PhysRecord λ p r t` (Lemma 1 plus the retained-`Y` parent bound):
  `0 < p ≤ q`, `r ≤ 1`, `1 − r ≤ t ≤ λ(1−p)/(1+λ(1−p))` and `t ≤ (1+λ)(1−r)/(1+λ(1−r))`.
  (Root records are tested at `r = 1, t = 0`, which lies in the domain.)
* The band propositions, for every `λ ∈ [lo, hi]` and every physical record:
  `LocalPaymentOK` — `Φ ≥ 0` for `xmin·q ≤ p < q` and every real `z` (the certified cover);
  `LeafOK` — `Φ ≥ 0` at the physical leaf `p = q`, `z = 1` (§8, the value `D₁`);
  `SmallMessageOK` — `Φ ≥ 0` for `0 < p < xmin·q` and every real `z` (§7);
  `Guards` — the decidable sign conditions on the rational data that the framework uses.
* The 14 rows of the O2 profile (`low`, `L1`, `L23`, `L4e`, `central0` … `central3`,
  `upperShoulder`, `H1`, `H2b`, `H3b`, `H4b`, `H8`) and their list `bands`.

Lean's `x / 0 = 0` makes the own Cauchy terms vanish at `p = q` (empty child list), as in the
proof; at the physical leaf only `z = 1` is used.  The certificate engines evaluate `g` through
its exact simplifications (4)/(5), which are lower bounds for `src`; `Φ` is nondecreasing in `g`.
-/

@[expose] public section

namespace Erdos993Lean.Analytic.O2

/-! ## Per-band coefficient data -/

/-- One rational coefficient table at an activity anchor: the values of `u, v, s, τ` at the nine
normalized knots `x = p/q = j/8` (`j = 0, …, 8`), and the vertex-independent multipliers `w, ℓ`. -/
structure CoeffTable where
  /-- knot values of `u` (the negative-response Cauchy multiplier) -/
  u : Fin 9 → ℚ
  /-- knot values of `v` (the positive-response Cauchy multiplier) -/
  v : Fin 9 → ℚ
  /-- knot values of `s` (the child-variance Cauchy multiplier) -/
  s : Fin 9 → ℚ
  /-- knot values of `τ` (the signed telescoping multiplier) -/
  tau : Fin 9 → ℚ
  /-- the packed child-mass multiplier `w` -/
  w : ℚ
  /-- the root-log multiplier `ℓ` (not O3's Laplace rate) -/
  ell : ℚ

/-- One O2 band: the activity interval `[lo, hi]`, the price `γ` (the variance cap is
`γ/(1 + λ) · W`), the left end `xmin` of the certified `x = p/q` cover (small messages lie below
it), and the coefficient tables at `λ = lo` (`left`) and `λ = hi` (`right`). -/
structure BandData where
  /-- left activity edge -/
  lo : ℚ
  /-- right activity edge -/
  hi : ℚ
  /-- the price `γ`; `c = γ/(1 + λ)` -/
  gamma : ℚ
  /-- the start of the certified normalized cover `x = p/q ∈ [xmin, 1]` -/
  xmin : ℚ
  /-- the table at `λ = lo` -/
  left : CoeffTable
  /-- the table at `λ = hi` -/
  right : CoeffTable

/-! ## Interpolation -/

/-- Linear interpolation in the activity between the anchor values `a` (at `lo`) and `b` (at
`hi`): `a + (λ − lo)/(hi − lo) · (b − a)` (equal to `a` if `lo = hi`). -/
noncomputable def lerp (lo hi a b : ℚ) (lam : ℝ) : ℝ :=
  (a : ℝ) + (lam - lo) / ((hi : ℝ) - lo) * ((b : ℝ) - a)

/-- The hat function `max(0, 1 − |y|)`. -/
noncomputable def hat (y : ℝ) : ℝ := max 0 (1 - |y|)

/-- Piecewise-linear interpolation on the knots `x = j/8`: `∑_j f_j · hat(8x − j)`.  On
`[j/8, (j+1)/8]` it is the affine interpolation of `f_j` and `f_{j+1}`. -/
noncomputable def pwLin (f : Fin 9 → ℝ) (x : ℝ) : ℝ :=
  ∑ j : Fin 9, f j * hat (8 * x - (j : ℕ))

namespace BandData

variable (b : BandData)

/-- The activity interval of the band. -/
def InBand (lam : ℝ) : Prop := (b.lo : ℝ) ≤ lam ∧ lam ≤ b.hi

/-- The knot values of one field (`sel` picks `u`, `v`, `s` or `τ`) at activity `λ`. -/
noncomputable def knots (sel : CoeffTable → Fin 9 → ℚ) (lam : ℝ) : Fin 9 → ℝ :=
  fun j => lerp b.lo b.hi (sel b.left j) (sel b.right j) lam

/-- One field at activity `λ` and cavity probability `p`: `pwLin` of its knot values at
`x = p/q_λ`. -/
noncomputable def field (sel : CoeffTable → Fin 9 → ℚ) (lam p : ℝ) : ℝ :=
  pwLin (b.knots sel lam) (p / actQ lam)

/-- The field `u(λ, p)`. -/
noncomputable def uF (lam p : ℝ) : ℝ := b.field CoeffTable.u lam p

/-- The field `v(λ, p)`. -/
noncomputable def vF (lam p : ℝ) : ℝ := b.field CoeffTable.v lam p

/-- The field `s(λ, p)`. -/
noncomputable def sF (lam p : ℝ) : ℝ := b.field CoeffTable.s lam p

/-- The field `τ(λ, p)`. -/
noncomputable def tauF (lam p : ℝ) : ℝ := b.field CoeffTable.tau lam p

/-- The multiplier `w(λ)`. -/
noncomputable def wF (lam : ℝ) : ℝ := lerp b.lo b.hi b.left.w b.right.w lam

/-- The multiplier `ℓ(λ)`. -/
noncomputable def ellF (lam : ℝ) : ℝ := lerp b.lo b.hi b.left.ell b.right.ell lam

/-- The price `c = γ/(1 + λ)`. -/
noncomputable def price (lam : ℝ) : ℝ := (b.gamma : ℝ) / (1 + lam)

end BandData

/-! ## The source (Lemma 2) -/

/-- `f_q(x) = max((1+q)x/(2q), (1+q)x/(2q²) + (q−1)/(2q))`. -/
noncomputable def fq (q x : ℝ) : ℝ :=
  max ((1 + q) * x / (2 * q)) ((1 + q) * x / (2 * q ^ 2) + (q - 1) / (2 * q))

/-- `H_c(p) = min(q, 1 − p/(λ(1−p)))`, the bound on a child's cavity probability. -/
noncomputable def cavH (lam p : ℝ) : ℝ := min (actQ lam) (1 - p / (lam * (1 - p)))

/-- `M_up(p, r) = max(1 − r, (1 − pr) H_c(p))`, the bound on every neighbour's marginal. -/
noncomputable def mUp (lam p r : ℝ) : ℝ := max (1 - r) ((1 - p * r) * cavH lam p)

/-- The retained cavity source `g(p, r) = max(f_q(pr), (1 + f_q(pr) − f_q(M_up(p, r)))/2)`. -/
noncomputable def src (lam p r : ℝ) : ℝ :=
  max (fq (actQ lam) (p * r)) ((1 + fq (actQ lam) (p * r) - fq (actQ lam) (mUp lam p r)) / 2)

/-! ## Child masses (§4) -/

/-- `T = log(λ(1−p)/p)`, the total logarithmic child mass `∑_u −log(1 − p_u)`. -/
noncomputable def logMass (lam p : ℝ) : ℝ := Real.log (lam * (1 - p) / p)

/-- `j = ⌊T/L⌋` with `L = log(1 + λ)`: the number of full child masses in the extremal packing. -/
noncomputable def packJ (lam p : ℝ) : ℕ := ⌊logMass lam p / Real.log (1 + lam)⌋₊

/-- The residual mass `T − jL ∈ [0, L)`. -/
noncomputable def packRes (lam p : ℝ) : ℝ := logMass lam p - (packJ lam p : ℝ) * Real.log (1 + lam)

/-- `H = jλ + e^{T−jL} − 1`, the packed upper bound of `∑_u p_u/(1 − p_u)` (eq. (7)). -/
noncomputable def packH (lam p : ℝ) : ℝ := (packJ lam p : ℝ) * lam + Real.exp (packRes lam p) - 1

/-- `φ = jq + 1 − e^{−(T−jL)}`, the packed lower bound of `∑_u p_u` (eq. (8)). -/
noncomputable def packPhi (lam p : ℝ) : ℝ :=
  (packJ lam p : ℝ) * actQ lam + 1 - Real.exp (-packRes lam p)

/-- `h(p) = p/(−log(1 − p))`. -/
noncomputable def hFun (p : ℝ) : ℝ := p / (-Real.log (1 - p))

/-- `G(p) = log(p/(λ(1−p)²))`, the signed logarithmic root-credit density (eq. (10)). -/
noncomputable def logG (lam p : ℝ) : ℝ := Real.log (p / (lam * (1 - p) ^ 2))

/-! ## The local payment (eq. (11)) -/

namespace BandData

variable (b : BandData)

/-- `R_u = u(p)(z−1)₊²/(pT) − u(t) h(p) z₋²`. -/
noncomputable def Ru (lam p t z : ℝ) : ℝ :=
  b.uF lam p * (max (z - 1) 0) ^ 2 / (p * logMass lam p) - b.uF lam t * hFun p * (max (-z) 0) ^ 2

/-- `R_v = v(p)(1−z)₊²/(pT) − v(t) h(p) z₊²`. -/
noncomputable def Rv (lam p t z : ℝ) : ℝ :=
  b.vF lam p * (max (1 - z) 0) ^ 2 / (p * logMass lam p) - b.vF lam t * hFun p * (max z 0) ^ 2

/-- `R_s = r s(p)(1−z)²/H − (1−r) s(t)(1−p) z²`. -/
noncomputable def Rs (lam p r t z : ℝ) : ℝ :=
  r * b.sF lam p * (1 - z) ^ 2 / packH lam p - (1 - r) * b.sF lam t * (1 - p) * z ^ 2

/-- `R_τ = r τ(p)(z − 1) + (1 − r) τ(t) z`. -/
noncomputable def Rtau (lam p r t z : ℝ) : ℝ :=
  r * b.tauF lam p * (z - 1) + (1 - r) * b.tauF lam t * z

end BandData

/-- `R_w = z − 1 + r φ`. -/
noncomputable def Rw (lam p r z : ℝ) : ℝ := z - 1 + r * packPhi lam p

namespace BandData

variable (b : BandData)

/-- **The local payment (eq. (11))** at a nonroot record: own cavity probability `p`,
`r = 1 − π_parent`, the parent's cavity probability `t`, signed response `z`:
`Φ = c r g − r(1−p)z² + R_u + R_v + R_s + R_τ + w R_w − ℓ G/p`. -/
noncomputable def Phi (lam p r t z : ℝ) : ℝ :=
  b.price lam * r * src lam p r - r * (1 - p) * z ^ 2 + b.Ru lam p t z + b.Rv lam p t z +
    b.Rs lam p r t z + b.Rtau lam p r t z + b.wF lam * Rw lam p r z - b.ellF lam * logG lam p / p

/-- **The root payment**: `Φ` with `r = 1` and no incoming parent charges. -/
noncomputable def PhiRoot (lam p z : ℝ) : ℝ :=
  b.price lam * src lam p 1 - (1 - p) * z ^ 2 +
    b.uF lam p * (max (z - 1) 0) ^ 2 / (p * logMass lam p) +
    b.vF lam p * (max (1 - z) 0) ^ 2 / (p * logMass lam p) +
    b.sF lam p * (1 - z) ^ 2 / packH lam p + b.tauF lam p * (z - 1) +
    b.wF lam * Rw lam p 1 z - b.ellF lam * logG lam p / p

end BandData

/-! ## The physical record domain (Lemma 1 and the retained-`Y` parent bound) -/

/-- **A physical nonroot record** at activity `λ` (`q = λ/(1+λ)`): `0 < p ≤ q`, `r ≤ 1`,
`1 − r ≤ t` (the parent's marginal is at most its cavity probability),
`t ≤ λ(1−p)/(1+λ(1−p))` (the parent's child product contains `1 − p`), and
`t ≤ (1+λ)(1−r)/(1+λ(1−r))` (the parent's own `r`-bound, from its parent's marginal; the
retained-`Y` inclusion).  Root records are tested at `r = 1`, `t = 0`. -/
def PhysRecord (lam p r t : ℝ) : Prop :=
  0 < p ∧ p ≤ actQ lam ∧ r ≤ 1 ∧ 1 - r ≤ t ∧ t ≤ lam * (1 - p) / (1 + lam * (1 - p)) ∧
    t ≤ (1 + lam) * (1 - r) / (1 + lam * (1 - r))

/-! ## The band propositions -/

namespace BandData

variable (b : BandData)

/-- **The certified local payment** of a band: for every `λ ∈ [lo, hi]`, every physical record
with `xmin·q ≤ p < q` and every real response `z`, `Φ ≥ 0`.  (It is proved from the
certificate; the certificates test the parent at the two ends of its admissible interval and at
the common knots between, which suffices because `Φ` is affine in `t` between knots.) -/
def LocalPaymentOK : Prop :=
  ∀ lam : ℝ, b.InBand lam → ∀ p r t z : ℝ, PhysRecord lam p r t →
    (b.xmin : ℝ) * actQ lam ≤ p → p < actQ lam → 0 ≤ b.Phi lam p r t z

/-- **The leaf endpoint** (§8): at `p = q` (empty child list) only `z = 1` is physical, and
`Φ = D₁ ≥ 0` there. -/
def LeafOK : Prop :=
  ∀ lam : ℝ, b.InBand lam → ∀ r t : ℝ, PhysRecord lam (actQ lam) r t →
    0 ≤ b.Phi lam (actQ lam) r t 1

/-- **The small-message boundary** (§7): `Φ ≥ 0` for `0 < p < xmin·q` and every real `z`. -/
def SmallMessageOK : Prop :=
  ∀ lam : ℝ, b.InBand lam → ∀ p r t z : ℝ, PhysRecord lam p r t →
    p < (b.xmin : ℝ) * actQ lam → 0 ≤ b.Phi lam p r t z

/-- **The sign guards** on the rational data used by the framework: `0 < lo ≤ hi`, `0 ≤ γ`,
`0 < xmin ≤ 1`, and `u, v, s, w, ℓ ≥ 0` at both anchors (so `u, v, s, w, ℓ ≥ 0` on the band). -/
def Guards : Prop :=
  0 < b.lo ∧ b.lo ≤ b.hi ∧ 0 ≤ b.gamma ∧ 0 < b.xmin ∧ b.xmin ≤ 1 ∧
    (∀ j, 0 ≤ b.left.u j) ∧ (∀ j, 0 ≤ b.right.u j) ∧
    (∀ j, 0 ≤ b.left.v j) ∧ (∀ j, 0 ≤ b.right.v j) ∧
    (∀ j, 0 ≤ b.left.s j) ∧ (∀ j, 0 ≤ b.right.s j) ∧
    0 ≤ b.left.w ∧ 0 ≤ b.right.w ∧ 0 ≤ b.left.ell ∧ 0 ≤ b.right.ell

instance : Decidable b.Guards := by unfold Guards; infer_instance

/-- **Everything the O2 framework needs of one band.** -/
structure OK : Prop where
  /-- the sign guards (decidable) -/
  guards : b.Guards
  /-- the certified local payment -/
  pay : b.LocalPaymentOK
  /-- the leaf endpoint -/
  leaf : b.LeafOK
  /-- the small-message boundary -/
  small : b.SmallMessageOK

end BandData

