module

public import Erdos993Lean.Analytic.V213.FiberOuterRegionData

/-!
All ten accepted F13 Eq102/103 windows, keyed by printed window identity.
Full rational trees retain the actual accepted F05 class parameters,
N0=mu_D*l+2, the degree-five exponential sum, capped inverse, X test and
both signs of the unweighted price. Data only until shape/kernel checks.

-/

@[expose] public section
namespace Erdos993Lean.Analytic.V213

inductive FiberWindowIdentity where
  | window1 | window2 | window3 | window4 | window5 | window6 | window7 | window8 | window9 | window10

inductive FiberWindowRole where
  | gain | rate | bonus | anchor | inverse | minorant | gap | price

structure FiberWindowRow where
  printed : String
  outerClass : FiberOuterClassIdentity
  a : lowMeanFraction
  b : lowMeanFraction
  l : lowMeanFraction
  h : lowMeanFraction
  N0 : lowMeanFraction
  v : lowMeanFraction
  X : lowMeanFraction
  epsilon_X : lowMeanFraction
  L_W : lowMeanFraction
  phi : lowMeanFraction
  rho0 : lowMeanFraction
  Delta0 : lowMeanFraction
  x : lowMeanFraction
  w : lowMeanFraction
  actual_X : lowMeanFraction

