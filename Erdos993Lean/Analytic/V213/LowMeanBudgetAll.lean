theorem lowMean_list_getD_mem {α : Type*} (xs : List α) (d : α) (i : ℕ) (hi : i < xs.length) : xs.getD i d ∈ xs := by
  induction xs generalizing i with
  | nil => simp at hi
  | cons x xs ih =>
    cases i with
    | zero => simp
    | succ i =>
      rw [List.getD_cons_succ]
      exact List.mem_cons_of_mem x (ih i (by simpa using hi))

theorem lowMean_list_all_range {α : Type*} (xs : List α) (d : α) (test : α → Bool)
    (h : xs.all test = true) : (List.range xs.length).all (fun i => test (xs.getD i d)) = true := by
  apply List.all_eq_true.mpr
  intro i hi
  exact List.all_eq_true.mp h _ (lowMean_list_getD_mem xs d i (List.mem_range.mp hi))

