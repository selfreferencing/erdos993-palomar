/-! Complete direct seeds, with every core rank, both half intervals, and exact stronger target. -/

@[expose] public section

namespace Erdos993Lean.Analytic.V213

noncomputable def lowMeanSeedRecords : List LowMeanDirectSeedInput :=
  lowMeanSeedGroup0000 ++ lowMeanSeedGroup0016 ++ lowMeanSeedGroup0032 ++ lowMeanSeedGroup0048 ++ lowMeanSeedGroup0064 ++ lowMeanSeedGroup0080 ++ lowMeanSeedGroup0096 ++ lowMeanSeedGroup0112 ++ lowMeanSeedGroup0128 ++ lowMeanSeedGroup0144 ++ lowMeanSeedGroup0160 ++ lowMeanSeedGroup0176 ++ lowMeanSeedGroup0192 ++ lowMeanSeedGroup0208 ++ lowMeanSeedGroup0224 ++ lowMeanSeedGroup0240 ++ lowMeanSeedGroup0256 ++ lowMeanSeedGroup0272 ++ lowMeanSeedGroup0288 ++ lowMeanSeedGroup0304 ++ lowMeanSeedGroup0320 ++ lowMeanSeedGroup0336 ++ lowMeanSeedGroup0352 ++ lowMeanSeedGroup0368 ++ lowMeanSeedGroup0384 ++ lowMeanSeedGroup0400 ++ lowMeanSeedGroup0416 ++ lowMeanSeedGroup0432 ++ lowMeanSeedGroup0448 ++ lowMeanSeedGroup0464 ++ lowMeanSeedGroup0480 ++ lowMeanSeedGroup0496 ++ lowMeanSeedGroup0512 ++ lowMeanSeedGroup0528 ++ lowMeanSeedGroup0544 ++ lowMeanSeedGroup0560

theorem lowMean_seeds_kernel : lowMeanSeedRecords.all
    (fun s => lowMeanDirectSeedCheck lowMeanWidthPairs (lowMeanCoreFiberAt s.record) s) = true := by
  simp only [lowMeanSeedRecords, List.all_append, lowMean_seedGroup0000_kernel, lowMean_seedGroup0016_kernel, lowMean_seedGroup0032_kernel, lowMean_seedGroup0048_kernel, lowMean_seedGroup0064_kernel, lowMean_seedGroup0080_kernel, lowMean_seedGroup0096_kernel, lowMean_seedGroup0112_kernel, lowMean_seedGroup0128_kernel, lowMean_seedGroup0144_kernel, lowMean_seedGroup0160_kernel, lowMean_seedGroup0176_kernel, lowMean_seedGroup0192_kernel, lowMean_seedGroup0208_kernel, lowMean_seedGroup0224_kernel, lowMean_seedGroup0240_kernel, lowMean_seedGroup0256_kernel, lowMean_seedGroup0272_kernel, lowMean_seedGroup0288_kernel, lowMean_seedGroup0304_kernel, lowMean_seedGroup0320_kernel, lowMean_seedGroup0336_kernel, lowMean_seedGroup0352_kernel, lowMean_seedGroup0368_kernel, lowMean_seedGroup0384_kernel, lowMean_seedGroup0400_kernel, lowMean_seedGroup0416_kernel, lowMean_seedGroup0432_kernel, lowMean_seedGroup0448_kernel, lowMean_seedGroup0464_kernel, lowMean_seedGroup0480_kernel, lowMean_seedGroup0496_kernel, lowMean_seedGroup0512_kernel, lowMean_seedGroup0528_kernel, lowMean_seedGroup0544_kernel, lowMean_seedGroup0560_kernel, Bool.and_self]

theorem lowMean_seeds_length : lowMeanSeedRecords.length = 564 := by decide +kernel

noncomputable def lowMeanSeedAt (i : ℕ) : LowMeanDirectSeedInput := lowMeanSeedRecords.getD i lowMeanSeedRecord0000

theorem lowMean_seeds_frozenOrder_kernel : (List.range 564).all (fun i => decide ((lowMeanSeedAt i).record = i)) = true := by
  decide +kernel

theorem lowMean_seedAt_record (i : ℕ) (hi : i < 564) : (lowMeanSeedAt i).record = i :=
  of_decide_eq_true (Erdos993Lean.F4Fast.forall_lt_of_range_all lowMean_seeds_frozenOrder_kernel i hi)

theorem lowMean_seeds_range_kernel : (List.range 564).all
    (fun i => lowMeanDirectSeedCheck lowMeanWidthPairs (lowMeanCoreFiberAt i) (lowMeanSeedAt i)) = true := by
  apply List.all_eq_true.mpr
  intro i hi
  have hin : i < 564 := List.mem_range.mp hi
  have hm : lowMeanSeedAt i ∈ lowMeanSeedRecords :=
    lowMean_list_getD_mem _ _ i (by simpa only [lowMean_seeds_length] using hin)
  have h := List.all_eq_true.mp lowMean_seeds_kernel _ hm
  rw [lowMean_seedAt_record i hin] at h
  exact h

theorem lowMean_seedAt_checked (i : ℕ) (hi : i < 564) :
    lowMeanDirectSeedCheck lowMeanWidthPairs (lowMeanCoreFiberAt i) (lowMeanSeedAt i) = true :=
  Erdos993Lean.F4Fast.forall_lt_of_range_all lowMean_seeds_range_kernel i hi

theorem lowMean_all_direct_seeds (i : ℕ) (hi : i < 564) {q : ℝ}
    (hq : q ∈ Set.Icc (lowMeanFractionReal (lowMeanFiberCertificate (lowMeanCoreFiberAt i)).l)
      (lowMeanFractionReal (lowMeanFiberCertificate (lowMeanCoreFiberAt i)).h)) (j : ℤ) :
    lowMeanFractionReal (lowMeanCoreFiberAt i).zeta ≤
      lowMeanCertificateSlack (lowMeanFiberCertificate (lowMeanCoreFiberAt i)) (lowMeanCoreFiberAt i).M j q := by
  have hs := lowMean_seedAt_checked i hi
  simp only [lowMeanDirectSeedCheck, Bool.and_eq_true] at hs
  exact lowMean_fiber_seed { fiber := lowMeanCoreFiberAt i, positions := (lowMeanSeedAt i).positions }
    (lowMean_coreAt_checked i hi) hs.1 hq j

theorem lowMean_all_direct_epsilon (i : ℕ) (hi : i < 564) {q : ℝ}
    (hq : q ∈ Set.Icc (lowMeanFractionReal (lowMeanFiberCertificate (lowMeanCoreFiberAt i)).l)
      (lowMeanFractionReal (lowMeanFiberCertificate (lowMeanCoreFiberAt i)).h)) (j : ℤ) :
    (1 / 100000 : ℝ) ≤
      lowMeanCertificateSlack (lowMeanFiberCertificate (lowMeanCoreFiberAt i)) (lowMeanCoreFiberAt i).M j q :=
  lowMean_directSeed_epsilon lowMeanWidthPairs _ _ (lowMean_coreAt_checked i hi) (lowMean_seedAt_checked i hi) hq j

theorem lowMean_all_direct_target_exact (i : ℕ) (hi : i < 564) :
    lowMeanFractionReal (lowMeanCoreFiberAt i).zeta = (1 / 100000 : ℝ) +
      lowMeanCertificatePotential (lowMeanFiberCertificate (lowMeanCoreFiberAt i))
        (lowMeanDirectTargetR lowMeanWidthPairs (lowMeanCoreFiberAt i).certificate (lowMeanCoreFiberAt i).M) -
      lowMeanCertificatePotential (lowMeanFiberCertificate (lowMeanCoreFiberAt i)) (lowMeanCoreFiberAt i).M := by
  have hs := lowMean_seedAt_checked i hi
  simp only [lowMeanDirectSeedCheck, Bool.and_eq_true] at hs
  have he := lowMean_directTarget_exact lowMeanWidthPairs _ _ hs.2
  have hm := hs.2
  simp only [lowMeanDirectTargetCheck, Bool.and_eq_true, decide_eq_true_eq] at hm
  rw [hm.1.2.1] at he
  exact he

theorem lowMean_core_keys_distinct : (lowMeanCoreFibers.map (fun f => (f.certificate, f.M))).Nodup := by decide +kernel

theorem lowMean_core_position_count : (lowMeanCoreFibers.flatMap LowMeanFiberInput.core).length = 1057 := by decide +kernel

theorem lowMean_seed_position_count : (lowMeanSeedRecords.flatMap LowMeanDirectSeedInput.positions).length = 1057 := by decide +kernel

theorem lowMean_seed_kind_counts :
    ((lowMeanSeedRecords.flatMap LowMeanDirectSeedInput.positions).filter (fun w => w.mode == 0)).length = 993 ∧
    ((lowMeanSeedRecords.flatMap LowMeanDirectSeedInput.positions).filter (fun w => w.mode == 1)).length = 57 ∧
    ((lowMeanSeedRecords.flatMap LowMeanDirectSeedInput.positions).filter (fun w => w.mode == 2)).length = 7 := by decide +kernel

theorem lowMean_seed_budget_coverage :
    (lowMeanSeedRecords.flatMap LowMeanDirectSeedInput.positions).flatMap lowMeanSeedChoiceIndices = List.range 1114 := by decide +kernel

end Erdos993Lean.Analytic.V213

