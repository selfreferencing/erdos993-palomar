/-- Retained source input25; three exact custody equalities plus group containment and rate domination. -/
theorem input_facts_25 :
    inputLo 25=N44.Data.pieceLo.getD 25 0 ∧
    inputHi 25=N44.Data.pieceHi.getD 25 0 ∧
    inputRate 25=(N44.Data.rates44.getD 25 []).getD 0 0 ∧
    groupLo (groupOf 25)≤ inputLo 25 ∧ inputHi 25≤groupHi (groupOf 25) ∧
    inputRate 25≤groupBar (groupOf 25) ∧ groupOf 25<23 := by
  exact IntInput.original_input_fact 25 (by decide +kernel)

