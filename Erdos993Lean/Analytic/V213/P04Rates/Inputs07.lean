/-- Retained source input35; three exact custody equalities plus group containment and rate domination. -/
theorem input_facts_35 :
    inputLo 35=N44.Data.pieceLo.getD 35 0 ∧
    inputHi 35=N44.Data.pieceHi.getD 35 0 ∧
    inputRate 35=(N44.Data.rates44.getD 35 []).getD 0 0 ∧
    groupLo (groupOf 35)≤ inputLo 35 ∧ inputHi 35≤groupHi (groupOf 35) ∧
    inputRate 35≤groupBar (groupOf 35) ∧ groupOf 35<23 := by
  exact IntInput.original_input_fact 35 (by decide +kernel)

