/-- Retained source input40; three exact custody equalities plus group containment and rate domination. -/
theorem input_facts_40 :
    inputLo 40=N44.Data.pieceLo.getD 40 0 ∧
    inputHi 40=N44.Data.pieceHi.getD 40 0 ∧
    inputRate 40=(N44.Data.rates44.getD 40 []).getD 0 0 ∧
    groupLo (groupOf 40)≤ inputLo 40 ∧ inputHi 40≤groupHi (groupOf 40) ∧
    inputRate 40≤groupBar (groupOf 40) ∧ groupOf 40<23 := by
  exact IntInput.original_input_fact 40 (by decide +kernel)

