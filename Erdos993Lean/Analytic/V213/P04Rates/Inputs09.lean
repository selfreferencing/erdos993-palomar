/-- Retained source input45; three exact custody equalities plus group containment and rate domination. -/
theorem input_facts_45 :
    inputLo 45=N44.Data.pieceLo.getD 45 0 ∧
    inputHi 45=N44.Data.pieceHi.getD 45 0 ∧
    inputRate 45=(N44.Data.rates44.getD 45 []).getD 0 0 ∧
    groupLo (groupOf 45)≤ inputLo 45 ∧ inputHi 45≤groupHi (groupOf 45) ∧
    inputRate 45≤groupBar (groupOf 45) ∧ groupOf 45<23 := by
  exact IntInput.original_input_fact 45 (by decide +kernel)

