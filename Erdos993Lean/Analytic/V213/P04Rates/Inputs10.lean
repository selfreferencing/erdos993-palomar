/-- Retained source input50; three exact custody equalities plus group containment and rate domination. -/
theorem input_facts_50 :
    inputLo 50=N44.Data.pieceLo.getD 50 0 ∧
    inputHi 50=N44.Data.pieceHi.getD 50 0 ∧
    inputRate 50=(N44.Data.rates44.getD 50 []).getD 0 0 ∧
    groupLo (groupOf 50)≤ inputLo 50 ∧ inputHi 50≤groupHi (groupOf 50) ∧
    inputRate 50≤groupBar (groupOf 50) ∧ groupOf 50<23 := by
  exact IntInput.original_input_fact 50 (by decide +kernel)

