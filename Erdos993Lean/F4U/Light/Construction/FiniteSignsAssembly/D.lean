theorem actualFiniteFunctionSigns_D : ActualFiniteFunctionSigns .D := by
  intro reg phase endpoint control s lam t hlam ht0 ht1 hreg hs hsphase
  cases reg with
  | A =>
    have hc : control = .V0 := hreg rfl
    subst control
    cases phase with
    | first =>
      change s ≤ 4 at hs
      cases endpoint with
      | lower =>
        interval_cases s
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_1_0_V0_0.actual_positive hlam ht0 ht1
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_1_0_V0_1.actual_positive hlam ht0 ht1
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_1_0_V0_2.actual_positive hlam ht0 ht1
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_1_0_V0_3.actual_positive hlam ht0 ht1
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_1_0_V0_4.actual_positive hlam ht0 ht1
      | upper =>
        interval_cases s
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_1_1_V0_0.actual_positive hlam ht0 ht1
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_1_1_V0_1.actual_positive hlam ht0 ht1
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_1_1_V0_2.actual_positive hlam ht0 ht1
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_1_1_V0_3.actual_positive hlam ht0 ht1
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_1_1_V0_4.actual_positive hlam ht0 ht1
    | second =>
      change s ≤ 3 at hs
      have hs1 : 1 ≤ s := hsphase rfl
      cases endpoint with
      | lower =>
        interval_cases s
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_2_0_V0_1.actual_positive hlam ht0 ht1
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_2_0_V0_2.actual_positive hlam ht0 ht1
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_2_0_V0_3.actual_positive hlam ht0 ht1
      | upper =>
        interval_cases s
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_2_1_V0_1.actual_positive hlam ht0 ht1
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_2_1_V0_2.actual_positive hlam ht0 ht1
        · exact F4Unified.LightConstruction.ActualPositivity.D_A_2_1_V0_3.actual_positive hlam ht0 ht1
  | B =>
    cases control with
    | V0 =>
      cases phase with
      | first =>
        change s ≤ 3 at hs
        cases endpoint with
        | lower =>
          interval_cases s
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_1_0_V0_0.actual_positive hlam ht0 ht1
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_1_0_V0_1.actual_positive hlam ht0 ht1
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_1_0_V0_2.actual_positive hlam ht0 ht1
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_1_0_V0_3.actual_positive hlam ht0 ht1
        | upper =>
          interval_cases s
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_1_1_V0_0.actual_positive hlam ht0 ht1
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_1_1_V0_1.actual_positive hlam ht0 ht1
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_1_1_V0_2.actual_positive hlam ht0 ht1
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_1_1_V0_3.actual_positive hlam ht0 ht1
      | second =>
        change s ≤ 3 at hs
        have hs1 : 1 ≤ s := hsphase rfl
        cases endpoint with
        | lower =>
          interval_cases s
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_2_0_V0_1.actual_positive hlam ht0 ht1
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_2_0_V0_2.actual_positive hlam ht0 ht1
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_2_0_V0_3.actual_positive hlam ht0 ht1
        | upper =>
          interval_cases s
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_2_1_V0_1.actual_positive hlam ht0 ht1
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_2_1_V0_2.actual_positive hlam ht0 ht1
          · exact F4Unified.LightConstruction.ActualPositivity.D_B_2_1_V0_3.actual_positive hlam ht0 ht1
    | M0 =>
      cases phase with
