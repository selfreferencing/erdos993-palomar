theorem flatBudgetRecords_eq : lowMeanBudgetRecords = flatBudgetRecords := by rfl

noncomputable def fastCoreFiberAt (i : ℕ) : LowMeanFiberInput := nthR lowMeanFiber0000 flatCoreFibers i
noncomputable def fastBudgetAt (i : ℕ) : LowMeanBudgetRecord := nthR lowMeanBudgetRecord0000 flatBudgetRecords i

theorem fastCoreFiberAt_eq (i : ℕ) : fastCoreFiberAt i = lowMeanCoreFiberAt i := by
  unfold fastCoreFiberAt lowMeanCoreFiberAt
  rw [flatCoreFibers_eq]
  exact nthR_eq_getD _ _ i

theorem fastBudgetAt_eq (i : ℕ) : fastBudgetAt i = lowMeanBudgetAt i := by
  unfold fastBudgetAt lowMeanBudgetAt
  rw [flatBudgetRecords_eq]
  exact nthR_eq_getD _ _ i

noncomputable def fastSeedBudgetKeyCheck (f : LowMeanFiberInput) (j : ℤ) (i kind : ℕ) : Bool :=
  let r := fastBudgetAt i
  decide (i < 1114 ∧ r.certificate = f.certificate ∧ r.input.M = f.M ∧ r.input.j = j ∧
    r.input.zeta = f.zeta ∧ r.kind = kind)

theorem fastSeedBudgetKeyCheck_eq (f : LowMeanFiberInput) (j : ℤ) (i kind : ℕ) :
    fastSeedBudgetKeyCheck f j i kind = lowMeanSeedBudgetKeyCheck f j i kind := by
  simp only [fastSeedBudgetKeyCheck, lowMeanSeedBudgetKeyCheck, fastBudgetAt_eq]

noncomputable def fastSeedChoiceCheck (f : LowMeanFiberInput) (w : LowMeanSeedBudgetChoice) : Bool :=
  decide (w.mode ≤ 2) &&
  fastSeedBudgetKeyCheck f w.j w.left (if w.mode = 1 then 1 else if w.mode = 2 then 3 else 0) &&
  (if w.mode = 1 then fastSeedBudgetKeyCheck f w.j w.right 2 &&
    decide ((fastBudgetAt w.right).input.terms = (fastBudgetAt w.left).input.terms) else true)

theorem fastSeedChoiceCheck_eq (f : LowMeanFiberInput) (w : LowMeanSeedBudgetChoice) :
    fastSeedChoiceCheck f w = lowMeanSeedChoiceCheck f w := by
  simp only [fastSeedChoiceCheck, lowMeanSeedChoiceCheck, fastSeedBudgetKeyCheck_eq, fastBudgetAt_eq]

noncomputable def fastFiberBudgetCheck (b : LowMeanFiberBudgetInput) : Bool :=
  decide (b.positions.map LowMeanSeedBudgetChoice.j = b.fiber.core) &&
    b.positions.all (fastSeedChoiceCheck b.fiber)

theorem fastFiberBudgetCheck_eq (b : LowMeanFiberBudgetInput) :
    fastFiberBudgetCheck b = lowMeanFiberBudgetCheck b := by
  have h : fastSeedChoiceCheck b.fiber = lowMeanSeedChoiceCheck b.fiber :=
    funext (fastSeedChoiceCheck_eq b.fiber)
  simp only [fastFiberBudgetCheck, lowMeanFiberBudgetCheck, h]

noncomputable def fastDirectTargetCheck (ps : List LowMeanWidthPair) (f : LowMeanFiberInput)
    (w : LowMeanDirectTargetInput) : Bool :=
  decide (lowMeanDirectWidth ps f.certificate f.M = true ∧
    w.R = lowMeanDirectTargetR ps f.certificate f.M ∧ f.M ≤ w.R ∧
    lowMeanFractionValid f.zeta ∧ lowMeanFractionLE (1, 100000) f.zeta) &&
  fastEqualityCheck w.expr (lowMeanDirectTargetShape f w) f.zeta

theorem fastDirectTargetCheck_sound {ps : List LowMeanWidthPair} {f : LowMeanFiberInput}
    {w : LowMeanDirectTargetInput} (h : fastDirectTargetCheck ps f w = true) :
    lowMeanDirectTargetCheck ps f w = true := by
  simp only [fastDirectTargetCheck, Bool.and_eq_true] at h
  simp only [lowMeanDirectTargetCheck, Bool.and_eq_true]
  exact ⟨h.1, fastEqualityCheck_sound h.2⟩

noncomputable def fastDirectSeedCheck (ps : List LowMeanWidthPair) (f : LowMeanFiberInput)
    (s : LowMeanDirectSeedInput) : Bool :=
  fastFiberBudgetCheck { fiber := f, positions := s.positions } && fastDirectTargetCheck ps f s.target

theorem fastDirectSeedCheck_sound {ps : List LowMeanWidthPair} {f : LowMeanFiberInput}
    {s : LowMeanDirectSeedInput} (h : fastDirectSeedCheck ps f s = true) :
    lowMeanDirectSeedCheck ps f s = true := by
  simp only [fastDirectSeedCheck, Bool.and_eq_true] at h
  simp only [lowMeanDirectSeedCheck, Bool.and_eq_true]
  exact ⟨(fastFiberBudgetCheck_eq _).symm.trans h.1, fastDirectTargetCheck_sound h.2⟩

/-- A seed group that passes the fast check passes the original check. -/
theorem fastSeedGroup_sound (g : List LowMeanDirectSeedInput)
    (h : g.all (fun s => fastDirectSeedCheck lowMeanWidthPairs (fastCoreFiberAt s.record) s) = true) :
    g.all (fun s => lowMeanDirectSeedCheck lowMeanWidthPairs (lowMeanCoreFiberAt s.record) s) = true := by
  rw [List.all_eq_true] at h ⊢
  intro s hs
  have hs' : fastDirectSeedCheck lowMeanWidthPairs (fastCoreFiberAt s.record) s = true := h s hs
  rw [fastCoreFiberAt_eq] at hs'
  exact fastDirectSeedCheck_sound hs'

end Erdos993Lean.LowMeanFast

