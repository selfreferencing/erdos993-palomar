/-!
Cheaper kernel check for the low-mean seed groups.

`lowMeanDirectSeedCheck` looks fibers and budget records up by index with `List.getD` in
`lowMeanCoreFibers` and `lowMeanBudgetRecords`, which are deep chains of `++`; walking those chains is
most of the kernel time of a seed group.  Here the two lists are restated as flat literal lists (equal
by `rfl`), the lookup `nthR` is written on the recursors, and the one formula check per seed goes
through `fastEqualityCheck`.  `fastSeedGroup_sound` returns the original group statements.
-/

@[expose] public section

namespace Erdos993Lean.LowMeanFast
open Erdos993Lean.Analytic.V213

/-- List lookup written on the two recursors: one iota step on the list and one on the index per element. -/
noncomputable def nthR {α : Type} (d : α) (l : List α) : ℕ → α :=
  List.rec (motive := fun _ => ℕ → α) (fun _ => d)
    (fun a _ ih i => Nat.rec (motive := fun _ => α) a (fun k _ => ih k) i) l

theorem nthR_eq_getD {α : Type} (d : α) (l : List α) : ∀ i : ℕ, nthR d l i = l.getD i d := by
  induction l with
  | nil =>
    intro i
    exact (List.getD_nil).symm
  | cons a l ih =>
    intro i
    cases i with
    | zero => exact (List.getD_cons_zero).symm
    | succ k =>
      rw [List.getD_cons_succ]
      exact ih k

