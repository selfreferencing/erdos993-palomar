def d_F1_radius_split_expression : PolynomialExpr :=
  (.add (.matrix dF1Lo) (.mul (.pow .activity 6) (.matrix dF1Hi)))

set_option maxRecDepth 4096 in
theorem d_F1_radius_split_coefficients_check :
    PolynomialExpr.check (.matrix dF1RadiusData) d_F1_radius_split_expression = true := by
  decide +kernel

set_option maxRecDepth 4096 in
theorem d_F1_radius_split (v x : ℝ) :
    dFRadiusNum v x (dUpperNum v x) (eLogDen x) = matrixValue dF1Lo v x+v^6*matrixValue dF1Hi v x := by
  rw [d_F1_radius_value]
  have h := PolynomialExpr.check_sound _ _ d_F1_radius_split_coefficients_check v x
  simpa only [d_F1_radius_split_expression, PolynomialExpr.value, PolynomialExpr.matrix_value, fractionValue, Int.cast_ofNat, Int.cast_neg, Int.cast_one, Nat.cast_one, Nat.cast_ofNat, div_one, sub_eq_add_neg, neg_mul, one_mul] using h


noncomputable def dF1Piece (v x : ℝ) (i : Fin 6) : ℝ :=
  let A := 240*dDeltaNum v*(1-v)*(dBase v x)^3*dVacancyDen v x*(eLogDen x)*dSupportDen v
  let Q := 60*dProbNum v x*dBetaNum v*(1-v)^2*(dBase v x)^3*(eLogDen x)*dSupportDen v
  let lo := matrixValue dF1Lo v x
  let hi := matrixValue dF1Hi v x
  match i with
  | 0 => A*Q
  | 1 => A*lo
  | 2 => A*v^6*hi
  | 3 => -11*lo^2
  | 4 => -22*v^6*lo*hi
  | 5 => -11*v^12*hi^2

theorem d_F1_pieces (v x : ℝ) :
    dFNum v x (dUpperNum v x) (eLogDen x) = dF1Piece v x 0+dF1Piece v x 1+
      dF1Piece v x 2+dF1Piece v x 3+dF1Piece v x 4+dF1Piece v x 5 := by
  unfold dFNum
  rw [d_F1_radius_split]
  unfold dF1Piece
  ring

