  have hn5 : v^2*x-9*v^2/28-33*v/14-x-121/28 = -((1-v^2)*x+(3*v+11)^2/28) := by ring
  have he : (1758274477167001211613412821425866751259947808325632000000000000000000000000000000000000000000/1 : ℝ)*(v+1)^2*(v-1)^6*(v+11/3)^1*(v*x+3*v/7+x+11/7)^5*(x^2+4*x/3+1/9)^2 = (1758274477167001211613412821425866751259947808325632000000000000000000000000000000000000000000/1 : ℝ)*(v+1)^2*(1-v)^6*(v+11/3)^1*(v*x+3*v/7+x+11/7)^5*(x^2+4*x/3+1/9)^2 := by
