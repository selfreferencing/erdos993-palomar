theorem e_u2_discriminant_value (q : ℝ) :
    realHorner (e_u2_discriminant.map fractionValue) q =
      4*realHorner (e_u2_quotient_0.map fractionValue) q*realHorner (e_u2_a0.map fractionValue) q -
        (realHorner (e_u2_a1.map fractionValue) q)^2 := by
  apply parametricDiscriminant_value e_u2_a0 e_u2_a1 e_u2_quotient_0 e_u2_discriminant q
  · norm_num [e_u2_a0]
  · norm_num [e_u2_a1]
  · norm_num [e_u2_quotient_0]
  · exact reconstruct_157_E1_r8_U2_discriminant_identity

theorem e_u2_quotient_constant_lower (q z : ℝ) (hq : (13/23 : ℝ) ≤ q ∧ q ≤ 29/49) (hz : 0 ≤ z) :
    realHorner (e_u2_quotient_0.map fractionValue) q ≤ matrixValue e_u2_quotient_columns z q := by
  simp only [matrixValue, e_u2_quotient_columns, List.map_cons, List.map_nil]
  apply realHorner_constant_lower _ _ z hz
  intro v hv
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hv
  rcases hv with rfl | rfl | rfl | rfl | rfl
  · exact (e_u2_quotient_1_positive q hq).le
  · exact (e_u2_quotient_2_positive q hq).le
  · exact (e_u2_quotient_3_positive q hq).le
  · exact (e_u2_quotient_4_positive q hq).le
  · exact (e_u2_quotient_5_positive q hq).le

theorem e_u2_projective_positive (q z : ℝ) (hq : (13/23 : ℝ) ≤ q ∧ q ≤ 29/49) (hz : 0 ≤ z) :
    0 < matrixValue e_u2_projective_columns z q := by
  rw [e_u2_square_value]
  have hd := e_u2_discriminant_positive q hq
  rw [e_u2_discriminant_value] at hd
  simpa only [mul_comm] using square_expression_positive
    (realHorner (e_u2_a0.map fractionValue) q) (realHorner (e_u2_a1.map fractionValue) q)
    (1/4 : ℝ) (realHorner (e_u2_quotient_0.map fractionValue) q) (matrixValue e_u2_quotient_columns z q) z
    (e_u2_quotient_0_positive q hq) (e_u2_quotient_constant_lower q z hq hz) hd

theorem e_u2_numerator_positive (q t : ℝ) (hq : (13/23 : ℝ) ≤ q ∧ q ≤ 29/49)
    (ht0 : 0 ≤ t) (ht1 : t < 1) :
    0 < matrixValue numerator_E1_r8_U2 (q/(1-q)) ((1/4 : ℝ)+(1-(1/4 : ℝ))*t) := by
  have hc : fractionValue (⟨1, 4⟩ : Fraction) = (1/4 : ℝ) := by norm_num [fractionValue]
  rw [← hc]
  apply projectiveParentColumns_original_positive numerator_E1_r8_U2 e_u2_projective_columns ⟨1, 4⟩ q t
  · norm_num [numerator_E1_r8_U2]
  · norm_num
  · norm_num [numerator_E1_r8_U2]
  · norm_num [numerator_E1_r8_U2]
  · linarith only [hq.2]
