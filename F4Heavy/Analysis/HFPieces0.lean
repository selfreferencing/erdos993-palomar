def h_F0_radius_split_expression : PolynomialExpr :=
  (.add (.matrix hF0Lo) (.mul (.pow .activity 6) (.matrix hF0Hi)))

set_option maxRecDepth 4096 in
theorem h_F0_radius_split_coefficients_check :
    PolynomialExpr.check (.matrix hF0RadiusData) h_F0_radius_split_expression = true := by
  decide +kernel

set_option maxRecDepth 4096 in
theorem h_F0_radius_split (v x : ℝ) :
    hFRadiusNum v x (hLowerNum v x) (1+x) = matrixValue hF0Lo v x+v^6*matrixValue hF0Hi v x := by
  rw [h_F0_radius_value]
  have h := PolynomialExpr.check_sound _ _ h_F0_radius_split_coefficients_check v x
  simpa only [h_F0_radius_split_expression, PolynomialExpr.value, PolynomialExpr.matrix_value, fractionValue, Int.cast_ofNat, Int.cast_neg, Int.cast_one, Nat.cast_one, Nat.cast_ofNat, div_one, sub_eq_add_neg, neg_mul, one_mul] using h


noncomputable def hF0Piece (v x : ℝ) (i : Fin 6) : ℝ :=
  let A := 240*hDeltaNum v*(1-v)*(hBase v x)^3*hVacancyDen v x*(1+x)*hSupportDen v
  let Q := 48*hProbNum v x*hBetaNum v*(1-v)^2*(hBase v x)^3*(1+x)*hSupportDen v
  let lo := matrixValue hF0Lo v x
  let hi := matrixValue hF0Hi v x
  match i with
  | 0 => A*Q
  | 1 => A*lo
  | 2 => A*v^6*hi
  | 3 => -12*lo^2
  | 4 => -24*v^6*lo*hi
  | 5 => -12*v^12*hi^2

theorem h_F0_pieces (v x : ℝ) :
    hFNum v x (hLowerNum v x) (1+x) = hF0Piece v x 0+hF0Piece v x 1+
      hF0Piece v x 2+hF0Piece v x 3+hF0Piece v x 4+hF0Piece v x 5 := by
  unfold hFNum
  rw [h_F0_radius_split]
  unfold hF0Piece
  ring

