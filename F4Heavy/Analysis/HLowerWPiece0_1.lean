  rw [PolynomialExpr.matrix_value] at h
  rw [← h]
  simp only [sampleLW0Piece1, PolynomialExpr.value, sampleDelta_value, sampleLower_value,
    sampleProb_value, sampleBeta_value, sampleVertex_value, sampleBase_value,
    sampleSupport_value, fractionValue, Int.cast_ofNat, Int.cast_neg, Int.cast_one, Nat.cast_one, div_one,
