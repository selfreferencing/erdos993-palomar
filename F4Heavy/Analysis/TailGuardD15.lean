theorem tail_guard_D_15_identity_coefficients_check : PolynomialExpr.check tail_guard_D_15_identity_left_expression tail_guard_D_15_identity_right_expression = true := by
  decide +kernel

theorem tail_guard_D_15_identity (lam : ℝ) (hr : InRow .D lam) :
    tailGuard .D lam 15 = realHorner (tail_ray_D_15_numerator_power.map fractionValue) lam /
      realHorner (tail_ray_D_15_denominator_power.map fractionValue) lam := by
  have hp := PolynomialExpr.check_sound _ _ tail_guard_D_15_identity_coefficients_check 0 lam
  simp only [tail_guard_D_15_identity_left_expression, tail_guard_D_15_identity_right_expression, PolynomialExpr.value, PolynomialExpr.row_value, reflectTailDAlpha_value, reflectTailDBeta_value, reflectTailDDelta_value, reflectTailDGamma_value, reflectTailDHi_value, reflectTailDLo_value, reflectTailDScale_value, reflectTailExtraDEta_value, reflectTailExtraDPrice_value, fractionValue, Int.cast_ofNat, Int.cast_neg, Int.cast_one, Nat.cast_one, Nat.cast_ofNat, div_one, sub_eq_add_neg, neg_mul, one_mul] at hp
  have hl := inRow_activity_pos .D lam hr
  have hd := ne_of_gt (tail_ray_D_15_denominator_positive lam hr)
  have hT : 0 < tailTauLo .D lam := by
    have h := tail_guard_D_02_positive lam hr
    change 0 < tailTauLo .D lam - 3 / 2 at h
    linarith only [h]
  have hL : 0 < tailLStar .D lam := tail_guard_D_08_positive lam hr
  have hN := tail_LNumerator_positive .D lam hl hL
  have hs := tail_scale_positive .D
  have hden : tailFinalTD .D lam (32*(29+10*lam)) (29+10*lam) ≠ 0 := by
    simp only [tailFinalDD,tailFinalTD,tailProbabilityDen]
    positivity
  have hq : tailGuard .D lam 15 = (tailFinalTN .D lam (33*(29+10*lam)-8*(10*lam)) (32*(29+10*lam)) (10*lam) (29+10*lam))/(tailFinalTD .D lam (32*(29+10*lam)) (29+10*lam)) := by
    simpa only [tailGuard,tailChildC,tail_child_hb_quotient lam hl,div_one] using tail_final_T_quotient .D lam (33*(29+10*lam)-8*(10*lam)) (32*(29+10*lam)) (10*lam) (29+10*lam) hl (ne_of_gt hT) hL (by positivity) (by positivity)
  rw [hq]
  apply (div_eq_div_iff hden hd).mpr
  simpa only [tailFinalGN,tailFinalTN,tailFinalTD,tailFinalAN,tailFinalAD,
    tailFinalCN,tailFinalDN,tailFinalDD,tailProbabilityDen,tailP1Numerator,
    tailANumerator,tailLNumerator,sub_eq_add_neg,neg_mul,one_mul,mul_one,one_pow,
    div_eq_mul_inv,mul_assoc] using hp


theorem tail_guard_D_15_positive (lam : ℝ) (hr : InRow .D lam) : 0 < tailGuard .D lam 15 := by
  rw [tail_guard_D_15_identity lam hr]
  exact div_pos (tail_ray_D_15_numerator_positive lam hr) (tail_ray_D_15_denominator_positive lam hr)

