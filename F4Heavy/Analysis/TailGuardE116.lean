theorem tail_guard_E1_16_identity (lam : ℝ) (hr : InRow .E1 lam) :
    tailGuard .E1 lam 16 = realHorner (tail_ray_E1_16_numerator_power.map fractionValue) lam /
      realHorner (tail_ray_E1_16_denominator_power.map fractionValue) lam := by
  have hp := PolynomialExpr.check_sound _ _ tail_guard_E1_16_identity_coefficients_check 0 lam
  simp only [tail_guard_E1_16_identity_left_expression, tail_guard_E1_16_identity_right_expression, PolynomialExpr.value, PolynomialExpr.row_value, reflectTailE1Alpha_value, reflectTailE1Beta_value, reflectTailE1Delta_value, reflectTailE1Gamma_value, reflectTailE1Hi_value, reflectTailE1Lo_value, reflectTailE1Scale_value, reflectTailExtraE1Eta_value, reflectTailExtraE1Price_value, fractionValue, Int.cast_ofNat, Int.cast_neg, Int.cast_one, Nat.cast_one, Nat.cast_ofNat, div_one, sub_eq_add_neg, neg_mul, one_mul] at hp
  have hl := inRow_activity_pos .E1 lam hr
  have hd := ne_of_gt (tail_ray_E1_16_denominator_positive lam hr)
  have hT : 0 < tailTauLo .E1 lam := by
    have h := tail_guard_E1_02_positive lam hr
    change 0 < tailTauLo .E1 lam - 3 / 2 at h
    linarith only [h]
  have hL : 0 < tailLStar .E1 lam := tail_guard_E1_08_positive lam hr
  have hN := tail_LNumerator_positive .E1 lam hl hL
  have hs := tail_scale_positive .E1
  have hden : tailFinalTD .E1 lam (1) (8) ≠ 0 := by
    simp only [tailFinalDD,tailFinalTD,tailProbabilityDen]
    positivity
  have hq : tailGuard .E1 lam 16 = (tailFinalTN .E1 lam (1) (1) (1) (8))/(tailFinalTD .E1 lam (1) (8)) := by
    simpa only [tailGuard,tailChildC,div_one] using tail_final_T_quotient .E1 lam (1) (1) (1) (8) hl (ne_of_gt hT) hL (by positivity) (by positivity)
  rw [hq]
  apply (div_eq_div_iff hden hd).mpr
  simpa only [tailFinalGN,tailFinalTN,tailFinalTD,tailFinalAN,tailFinalAD,
    tailFinalCN,tailFinalDN,tailFinalDD,tailProbabilityDen,tailP1Numerator,
    tailANumerator,tailLNumerator,sub_eq_add_neg,neg_mul,one_mul,mul_one,one_pow,
    div_eq_mul_inv,mul_assoc] using hp


theorem tail_guard_E1_16_positive (lam : ℝ) (hr : InRow .E1 lam) : 0 < tailGuard .E1 lam 16 := by
  rw [tail_guard_E1_16_identity lam hr]
  exact div_pos (tail_ray_E1_16_numerator_positive lam hr) (tail_ray_E1_16_denominator_positive lam hr)

