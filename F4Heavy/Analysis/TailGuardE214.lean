theorem tail_guard_E2_14_identity_coefficients_check : PolynomialExpr.check tail_guard_E2_14_identity_left_expression tail_guard_E2_14_identity_right_expression = true := by
  decide +kernel

theorem tail_guard_E2_14_identity (lam : ℝ) (hr : InRow .E2 lam) :
    tailGuard .E2 lam 14 = realHorner (tail_ray_E2_14_numerator_power.map fractionValue) lam /
      realHorner (tail_ray_E2_14_denominator_power.map fractionValue) lam := by
  have hp := PolynomialExpr.check_sound _ _ tail_guard_E2_14_identity_coefficients_check 0 lam
  simp only [tail_guard_E2_14_identity_left_expression, tail_guard_E2_14_identity_right_expression, PolynomialExpr.value, PolynomialExpr.row_value, reflectTailE2Alpha_value, reflectTailE2Beta_value, reflectTailE2Delta_value, reflectTailE2Gamma_value, reflectTailE2Hi_value, reflectTailE2Lo_value, reflectTailE2Scale_value, reflectTailExtraE2Eta_value, reflectTailExtraE2Price_value, fractionValue, Int.cast_ofNat, Int.cast_neg, Int.cast_one, Nat.cast_one, Nat.cast_ofNat, div_one, sub_eq_add_neg, neg_mul, one_mul] at hp
  have hl := inRow_activity_pos .E2 lam hr
  have hd := ne_of_gt (tail_ray_E2_14_denominator_positive lam hr)
  have hT : 0 < tailTauLo .E2 lam := by
    have h := tail_guard_E2_02_positive lam hr
    change 0 < tailTauLo .E2 lam - 3 / 2 at h
    linarith only [h]
  have hL : 0 < tailLStar .E2 lam := tail_guard_E2_08_positive lam hr
  have hN := tail_LNumerator_positive .E2 lam hl hL
  have hs := tail_scale_positive .E2
  have hden : tailFinalTD .E2 lam (lam^2+12*lam+12) (29+10*lam) ≠ 0 := by
    simp only [tailFinalDD,tailFinalTD,tailProbabilityDen]
    positivity
  have hq : tailGuard .E2 lam 14 = (tailFinalTN .E2 lam (6*(2+lam)) (lam^2+12*lam+12) (10*lam) (29+10*lam))/(tailFinalTD .E2 lam (lam^2+12*lam+12) (29+10*lam)) := by
    simpa only [tailGuard,tailChildC,tail_child_h0_identity lam hl,div_one] using tail_final_T_quotient .E2 lam (6*(2+lam)) (lam^2+12*lam+12) (10*lam) (29+10*lam) hl (ne_of_gt hT) hL (by positivity) (by positivity)
  rw [hq]
  apply (div_eq_div_iff hden hd).mpr
  simpa only [tailFinalGN,tailFinalTN,tailFinalTD,tailFinalAN,tailFinalAD,
    tailFinalCN,tailFinalDN,tailFinalDD,tailProbabilityDen,tailP1Numerator,
    tailANumerator,tailLNumerator,sub_eq_add_neg,neg_mul,one_mul,mul_one,one_pow,
    div_eq_mul_inv,mul_assoc] using hp


theorem tail_guard_E2_14_positive (lam : ℝ) (hr : InRow .E2 lam) : 0 < tailGuard .E2 lam 14 := by
  rw [tail_guard_E2_14_identity lam hr]
  exact div_pos (tail_ray_E2_14_numerator_positive lam hr) (tail_ray_E2_14_denominator_positive lam hr)

