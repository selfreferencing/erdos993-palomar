set_option maxRecDepth 4096 in
theorem tail_guard_H_14_identity_coefficients_check : PolynomialExpr.check tail_guard_H_14_identity_left_expression tail_guard_H_14_identity_right_expression = true := by
  decide +kernel

theorem tail_guard_H_14_identity (lam : ℝ) (hr : InRow .H lam) :
    tailGuard .H lam 14 = realHorner (tail_ray_H_14_numerator_power.map fractionValue) lam /
      realHorner (tail_ray_H_14_denominator_power.map fractionValue) lam := by
  have hp := PolynomialExpr.check_sound _ _ tail_guard_H_14_identity_coefficients_check 0 lam
  simp only [tail_guard_H_14_identity_left_expression, tail_guard_H_14_identity_right_expression, PolynomialExpr.value, PolynomialExpr.row_value, reflectTailExtraHEta_value, reflectTailExtraHPrice_value, reflectTailHAlpha_value, reflectTailHBeta_value, reflectTailHDelta_value, reflectTailHGamma_value, reflectTailHHi_value, reflectTailHLo_value, reflectTailHScale_value, fractionValue, Int.cast_ofNat, Int.cast_neg, Int.cast_one, Nat.cast_one, Nat.cast_ofNat, div_one, sub_eq_add_neg, neg_mul, one_mul] at hp
  have hl := inRow_activity_pos .H lam hr
  have hd := ne_of_gt (tail_ray_H_14_denominator_positive lam hr)
  have hT : 0 < tailTauLo .H lam := by
    have h := tail_guard_H_02_positive lam hr
    change 0 < tailTauLo .H lam - 3 / 2 at h
    linarith only [h]
  have hL : 0 < tailLStar .H lam := tail_guard_H_08_positive lam hr
  have hN := tail_LNumerator_positive .H lam hl hL
  have hs := tail_scale_positive .H
  have hden : tailFinalTD .H lam (lam^2+12*lam+12) (29+10*lam) ≠ 0 := by
    simp only [tailFinalDD,tailFinalTD,tailProbabilityDen]
    positivity
  have hq : tailGuard .H lam 14 = (tailFinalTN .H lam (6*(2+lam)) (lam^2+12*lam+12) (10*lam) (29+10*lam))/(tailFinalTD .H lam (lam^2+12*lam+12) (29+10*lam)) := by
    simpa only [tailGuard,tailChildC,tail_child_h0_identity lam hl,div_one] using tail_final_T_quotient .H lam (6*(2+lam)) (lam^2+12*lam+12) (10*lam) (29+10*lam) hl (ne_of_gt hT) hL (by positivity) (by positivity)
  rw [hq]
  apply (div_eq_div_iff hden hd).mpr
  simpa only [tailFinalGN,tailFinalTN,tailFinalTD,tailFinalAN,tailFinalAD,
    tailFinalCN,tailFinalDN,tailFinalDD,tailProbabilityDen,tailP1Numerator,
    tailANumerator,tailLNumerator,sub_eq_add_neg,neg_mul,one_mul,mul_one,one_pow,
    div_eq_mul_inv,mul_assoc] using hp


theorem tail_guard_H_14_positive (lam : ℝ) (hr : InRow .H lam) : 0 < tailGuard .H lam 14 := by
  rw [tail_guard_H_14_identity lam hr]
  exact div_pos (tail_ray_H_14_numerator_positive lam hr) (tail_ray_H_14_denominator_positive lam hr)

